PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Reverse proxy / TLS awareness ---
# Set this ONLY if a reverse proxy or load balancer sits in front of the app
# and forwards X-Forwarded-For / X-Forwarded-Proto (nginx, an ALB, Cloudflare,
# a PaaS platform, etc). Leave unset if the app is directly internet-facing.
# See the comment above app.set('trust proxy', ...) in server.js for values.
TRUST_PROXY=1
# Only set this to true for local http:// development — it disables the
# Secure flag on the session cookie, which must stay on in production.
COOKIE_INSECURE=false

# --- Postgres (used by src/db.js) ---
# Any Postgres provider works: Supabase, Neon, Railway, RDS, self-hosted, etc.
# Use whatever connection string your provider gives you. If your provider
# uses connection pooling for serverless (Supabase's "Transaction pooler" on
# port 6543, Neon's pooled endpoint, etc.), prefer that one for short-lived
# connections; a normal direct connection works fine everywhere else.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CV file storage (used by src/storage.js) ---
# STORAGE_DRIVER=local (default) — files are saved to disk under UPLOAD_DIR
# and served through a short-lived signed link. Zero extra services needed;
# this is the right choice for a normal VPS, container, or any host with
# persistent disk.
STORAGE_DRIVER=local
UPLOAD_DIR=data/cv-uploads
# Used to sign the temporary CV download links (falls back to SESSION_SECRET
# if unset — fine for most setups, but a dedicated secret is cleaner).
CV_SIGNING_SECRET=change-this-to-another-long-random-string

# STORAGE_DRIVER=s3 — for hosts with no persistent disk (serverless / most
# PaaS). Works with any S3-compatible provider: AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO, or Supabase Storage's own
# S3-compatible endpoint if you want to keep using Supabase specifically.
# Uncomment and fill in if you switch STORAGE_DRIVER to s3:
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=                      # leave unset for real AWS S3
# S3_FORCE_PATH_STYLE=true          # usually needed for R2/MinIO/Supabase, not AWS
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- Email: AWS SES (used by src/notify.js). Same provider/env-var naming
# as the AfroStore codebase (src/lib/email.ts), for consistency across
# Prokip apps. Without these, emails are logged as 'simulated' in
# notification_log instead of actually sent.
# Note: while your SES account is in the sandbox, you can only send to
# verified recipient addresses — request production access to send to
# arbitrary candidate emails.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=careers@yourcompany.com
SES_FROM_NAME=Careers

# --- WhatsApp Cloud API (used by src/notify.js). Same integration as
# AfroStore (src/lib/whatsapp.ts). Without these, WhatsApp messages are
# logged as 'simulated' instead of actually sent.
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
