PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Reverse proxy / TLS awareness ---
# Set this ONLY if a reverse proxy or load balancer sits in front of the app
# and forwards X-Forwarded-For / X-Forwarded-Proto (nginx, an ALB, Cloudflare,
# a PaaS platform, etc). Leave unset if the app is directly internet-facing.
# See the comment above app.set('trust proxy', ...) in server.js for values.
TRUST_PROXY=1
# Only set this to true for local http:// development — it disables the
# Secure flag on the session cookie, which must stay on in production.
COOKIE_INSECURE=false

# --- Supabase Postgres (used by src/db.js) ---
# In Supabase: Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# The pooler is required for serverless functions (short-lived connections).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase Storage (used by src/storage.js for CV uploads) ---
# In Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: bucket name for CVs (auto-created as a PRIVATE bucket if it doesn't exist)
SUPABASE_CV_BUCKET=cvs

# --- Email (used by src/notify.js). Without these, emails are logged as
# 'simulated' in notification_log instead of actually sent. ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Careers <careers@yourcompany.com>"

# --- WhatsApp Cloud API (used by src/notify.js). Without these, WhatsApp
# messages are logged as 'simulated' instead of actually sent. ---
WHATSAPP_CLOUD_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
